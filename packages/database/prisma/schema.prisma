generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// btree_gist is enabled by the manual migration in
// prisma/manual-sql/001_exclusion_constraints.sql, not here —
// Prisma's postgresqlExtensions preview feature isn't needed for this schema.

// ---------- Enums ----------

enum RoleName {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  FINANCE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  OUT_OF_ORDER
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum BookingSource {
  DIRECT
  PHONE
  WALK_IN
  OTA
}

enum RoomBlockReason {
  MAINTENANCE
  RENOVATION
  VIP
  INTERNAL
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum PaymentType {
  CHARGE
  REFUND
}

enum HousekeepingStatus {
  DIRTY
  IN_PROGRESS
  INSPECTED
  READY
}

enum PriceAdjustmentType {
  PERCENTAGE
  FIXED
}

enum RoomChangeType {
  UPGRADE
  DOWNGRADE
  LATERAL
}

// ---------- Models ----------

model Hotel {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("Asia/Kolkata")
  address   Json?
  // Standard policy times, "HH:mm" 24-hour, compared against the wall-clock
  // moment check-in/checkout is actually performed (in `timezone`) to decide
  // whether the fees below apply. A fee of 0 effectively disables it.
  checkInTime     String   @default("14:00") @map("check_in_time")
  checkOutTime    String   @default("11:00") @map("check_out_time")
  earlyCheckInFee Decimal  @default(0) @map("early_check_in_fee") @db.Decimal(10, 2)
  lateCheckOutFee Decimal  @default(0) @map("late_check_out_fee") @db.Decimal(10, 2)
  // Data URL (e.g. "data:image/png;base64,...") — no object storage is wired
  // up in this app, so the logo is stored inline rather than as a file path.
  logoUrl   String?  @map("logo_url") @db.Text
  // When on, a housekeeping task auto-assigns to whoever HousekeepingFloorAssignment
  // names for that room's floor (see HousekeepingService.createDirtyTask). Off by
  // default so a hotel with no roster set up doesn't silently leave tasks assigned
  // to nobody-in-particular — manual assignment still works either way.
  housekeepingAutoAssignEnabled Boolean  @default(false) @map("housekeeping_auto_assign_enabled")
  createdAt                     DateTime @default(now()) @map("created_at")

  rooms                   Room[]
  roomTypes               RoomType[]
  guests                  Guest[]
  bookings                Booking[]
  userHotelRoles          UserHotelRole[]
  auditLogs               AuditLog[]
  pricingRules            PricingRule[]
  housekeepingFloorRoster HousekeepingFloorAssignment[]

  @@map("hotels")
}

model Role {
  id   String   @id @default(uuid())
  name RoleName @unique

  userHotelRoles UserHotelRole[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  userHotelRoles    UserHotelRole[]
  bookingsCreated   Booking[]          @relation("BookingCreatedBy")
  roomBlocksCreated RoomBlock[]
  housekeepingTasks       HousekeepingTask[]
  housekeepingTasksNudged HousekeepingTask[]              @relation("HousekeepingTaskNudgedBy")
  auditLogs         AuditLog[]
  auditLogsReverted AuditLog[]         @relation("AuditLogRevertedBy")
  guestsFlagged     Guest[]            @relation("GuestFlaggedBy")
  roomChargesAdded  RoomCharge[]
  roomChangesMade   RoomChangeLog[]
  housekeepingFloorAssignments HousekeepingFloorAssignment[]

  @@map("users")
}

model UserHotelRole {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  // NULL hotelId = a platform-wide role (SUPER_ADMIN). Every other role is scoped to one hotel.
  hotelId String? @map("hotel_id")
  roleId  String  @map("role_id")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  role  Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, hotelId, roleId])
  @@map("user_hotel_roles")
}

model RoomType {
  id            String  @id @default(uuid())
  hotelId       String  @map("hotel_id")
  name          String
  baseOccupancy Int     @default(2) @map("base_occupancy")
  maxOccupancy  Int     @default(3) @map("max_occupancy")
  baseRate      Decimal @map("base_rate") @db.Decimal(10, 2)
  amenities     Json    @default("[]")

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
  pricingRules PricingRule[]

  @@unique([hotelId, name])
  @@map("room_types")
}

// A repriceable adjustment on top of a room type's base rate — seasonal
// (bounded by startDate/endDate), day-of-week (weekend pricing, via
// daysOfWeek), or a standing dynamic adjustment (neither set, always
// applies). Rules aren't applied to bookings automatically anywhere yet;
// GET /pricing-rules/quote lets Settings preview the resulting rate.
model PricingRule {
  id         String  @id @default(uuid())
  hotelId    String  @map("hotel_id")
  // NULL = applies to every room type at this hotel.
  roomTypeId String? @map("room_type_id")
  name       String

  adjustmentType  PriceAdjustmentType @map("adjustment_type")
  // Signed: positive raises the rate, negative discounts it. A percentage
  // of -100 or lower would zero out (or invert) the rate, so it's rejected
  // in the service layer rather than here.
  adjustmentValue Decimal             @map("adjustment_value") @db.Decimal(6, 2)

  // Both null = no date restriction. When set, half-open like booking dates:
  // applies to nights in [startDate, endDate).
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // Empty = every day. Otherwise a subset of 0 (Sun) .. 6 (Sat), stored as
  // JSON for the same reason RoomType.amenities is — no array column
  // elsewhere in this schema and the set is always tiny.
  daysOfWeek Json    @default("[]") @map("days_of_week")
  active     Boolean @default(true)
  // Stacking order when multiple rules match the same night — applied
  // lowest to highest, each on top of the previous step's rate.
  priority   Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("pricing_rules")
}

model Room {
  id         String     @id @default(uuid())
  hotelId    String     @map("hotel_id")
  roomTypeId String     @map("room_type_id")
  roomNumber String     @map("room_number")
  floor      String?
  status     RoomStatus @default(AVAILABLE)

  hotel               Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType            RoomType           @relation(fields: [roomTypeId], references: [id])
  bookingRooms        BookingRoom[]
  roomBlocks          RoomBlock[]
  housekeepingTasks   HousekeepingTask[]
  roomChangesFrom     RoomChangeLog[]    @relation("RoomChangeFrom")
  roomChangesTo       RoomChangeLog[]    @relation("RoomChangeTo")

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

model Guest {
  id               String    @id @default(uuid())
  hotelId          String    @map("hotel_id")
  fullName         String    @map("full_name")
  email            String?
  phone            String?
  idDocumentType   String?   @map("id_document_type")
  idDocumentNumber String?   @map("id_document_number")
  notes            String?
  isFlagged        Boolean   @default(false) @map("is_flagged")
  flagReason       String?   @map("flag_reason")
  flaggedAt        DateTime? @map("flagged_at")
  flaggedById      String?   @map("flagged_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  flaggedBy User?     @relation("GuestFlaggedBy", fields: [flaggedById], references: [id])

  @@map("guests")
}

model Booking {
  id           String        @id @default(uuid())
  hotelId      String        @map("hotel_id")
  guestId      String        @map("guest_id")
  status       BookingStatus @default(DRAFT)
  source       BookingSource @default(DIRECT)
  checkInDate  DateTime      @map("check_in_date") @db.Date
  checkOutDate DateTime      @map("check_out_date") @db.Date
  createdById  String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  // Bumped by Prisma on every `booking.update()` — the "last action taken on
  // this booking" for the Bookings tab's sort, so a room change or extend on
  // an old reservation surfaces above one nobody has touched since creation.
  updatedAt    DateTime      @updatedAt @map("updated_at")

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest        Guest         @relation(fields: [guestId], references: [id])
  createdBy    User          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  bookingRooms   BookingRoom[]
  payments       Payment[]
  invoice        Invoice?
  roomCharges    RoomCharge[]
  roomChangeLogs RoomChangeLog[]

  @@index([hotelId, checkInDate, checkOutDate])
  @@map("bookings")
}

// Incidentals (water bottle, minibar, etc.) logged against a guest's current
// stay as they happen, rather than reconstructed from memory at checkout —
// checkout sums these into the folio alongside any one-off charges typed in
// at that moment. Tied to the booking (not the room) so it survives room
// swaps mid-stay and never leaks onto the next guest in that room.
model RoomCharge {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  description String
  amount      Decimal  @db.Decimal(10, 2)
  addedById   String   @map("added_by")
  createdAt   DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addedBy User    @relation(fields: [addedById], references: [id])

  @@map("room_charges")
}

model BookingRoom {
  id          String  @id @default(uuid())
  bookingId   String  @map("booking_id")
  roomId      String  @map("room_id")
  rateApplied Decimal @map("rate_applied") @db.Decimal(10, 2)
  occupants   Int     @default(1) @map("occupants")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])
  roomChangeLogs RoomChangeLog[]

  @@unique([roomId, bookingId])
  @@map("booking_rooms")
}

// One row per mid-stay room/rate change on a CHECKED_IN booking (see
// BookingsService.changeRoom). Nights before `effectiveDate` billed at
// `previousRate`, nights from `effectiveDate` onward at `newRate` — this is
// what lets CheckoutService prorate a stay that changed rooms mid-way,
// since BookingRoom itself only ever holds the current room/rate.
model RoomChangeLog {
  id            String         @id @default(uuid())
  bookingId     String         @map("booking_id")
  bookingRoomId String         @map("booking_room_id")
  fromRoomId    String         @map("from_room_id")
  toRoomId      String         @map("to_room_id")
  previousRate  Decimal        @map("previous_rate") @db.Decimal(10, 2)
  newRate       Decimal        @map("new_rate") @db.Decimal(10, 2)
  changeType    RoomChangeType @map("change_type")
  reason        String?
  effectiveDate DateTime       @map("effective_date") @db.Date
  changedById   String         @map("changed_by")
  createdAt     DateTime       @default(now()) @map("created_at")

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingRoom BookingRoom @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)
  fromRoom    Room        @relation("RoomChangeFrom", fields: [fromRoomId], references: [id])
  toRoom      Room        @relation("RoomChangeTo", fields: [toRoomId], references: [id])
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([bookingId])
  @@map("room_change_logs")
}

model RoomBlock {
  id          String          @id @default(uuid())
  roomId      String          @map("room_id")
  reason      RoomBlockReason
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime        @map("end_date") @db.Date
  notes       String?
  createdById String          @map("created_by")

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@map("room_blocks")
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @map("booking_id")
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  type      PaymentType   @default(CHARGE)
  reference String?
  createdAt DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Invoice {
  id            String   @id @default(uuid())
  bookingId     String   @unique @map("booking_id")
  // Breakdown of `subtotal` — stored alongside it (rather than re-derived from
  // Booking/RoomCharge at read time) because two of its inputs are decided in
  // the moment and can't be reconstructed later: whether the late check-out
  // fee applied depended on the wall-clock time checkout was processed, and
  // `additionalCharges`/`discounts` below are ad-hoc line items typed in at
  // checkout that exist nowhere else (unlike logged RoomCharges, which are
  // still queryable by bookingId after the fact).
  nights            Int
  roomSubtotal      Decimal  @map("room_subtotal") @db.Decimal(10, 2)
  chargesTotal      Decimal  @default(0) @map("charges_total") @db.Decimal(10, 2)
  lateCheckOutFee   Decimal  @default(0) @map("late_check_out_fee") @db.Decimal(10, 2)
  additionalCharges Json     @default("[]") @map("additional_charges")
  discounts         Json     @default("[]")
  subtotal          Decimal  @db.Decimal(10, 2)
  taxRatePercent    Decimal  @map("tax_rate_percent") @db.Decimal(5, 2)
  taxTotal          Decimal  @map("tax_total") @db.Decimal(10, 2)
  discountTotal     Decimal  @default(0) @map("discount_total") @db.Decimal(10, 2)
  grandTotal        Decimal  @map("grand_total") @db.Decimal(10, 2)
  pdfUrl            String?  @map("pdf_url")
  issuedAt          DateTime @default(now()) @map("issued_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model HousekeepingTask {
  id           String             @id @default(uuid())
  roomId       String             @map("room_id")
  status       HousekeepingStatus @default(DIRTY)
  assignedToId String?            @map("assigned_to")
  priority     Int                @default(0)
  createdAt    DateTime           @default(now()) @map("created_at")
  completedAt  DateTime?          @map("completed_at")
  // Set when a manager/front-desk user pings the assignee about an overdue
  // task from the Dashboard's alert (see HousekeepingService.nudge) — an
  // in-app-only signal surfaced on the Housekeeping board, not a push/SMS/email.
  nudgedAt     DateTime?          @map("nudged_at")
  nudgedById   String?            @map("nudged_by")
  // A guest-in-room request (e.g. "please tidy up", extra towels) raised via
  // HousekeepingService.requestService — unlike every other task here, the
  // room stays OCCUPIED throughout, so reaching READY must NOT flip it to
  // AVAILABLE the way a post-checkout turnover does (see updateTask's guard).
  serviceRequest Boolean          @default(false) @map("service_request")

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id])
  nudgedBy   User? @relation("HousekeepingTaskNudgedBy", fields: [nudgedById], references: [id])

  @@index([status, priority])
  @@map("housekeeping_tasks")
}

// The floor-to-staff roster behind Hotel.housekeepingAutoAssignEnabled — one
// staff member per floor per hotel. HousekeepingService reads this when a
// room goes DIRTY to auto-assign its task; it's otherwise just a lookup
// table with no behavior of its own.
model HousekeepingFloorAssignment {
  id      String @id @default(uuid())
  hotelId String @map("hotel_id")
  floor   String
  userId  String @map("user_id")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotelId, floor])
  @@map("housekeeping_floor_assignments")
}

// `diff` shape convention: { before: {...} | null, after: {...} | null } —
// only the fields that actually changed for an UPDATE; a full relevant
// snapshot for a CREATE (before: null) or DELETE (after: null). A REVERT
// entry stores the swapped before/after of the action it undid.
model AuditLog {
  id           String    @id @default(uuid())
  hotelId      String?   @map("hotel_id")
  actorId      String?   @map("actor_id")
  entity       String
  entityId     String    @map("entity_id")
  action       String
  diff         Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  revertedAt   DateTime? @map("reverted_at")
  revertedById String?   @map("reverted_by")

  hotel      Hotel? @relation(fields: [hotelId], references: [id])
  actor      User?  @relation(fields: [actorId], references: [id])
  revertedBy User?  @relation("AuditLogRevertedBy", fields: [revertedById], references: [id])

  @@index([entity, entityId])
  @@index([hotelId, createdAt])
  @@map("audit_logs")
}
